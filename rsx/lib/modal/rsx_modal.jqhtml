<%--
Rsx_Modal Component

Base modal component for displaying dialogs, forms, and custom content.
Uses Bootstrap 5 modal as foundation with custom sizing and behavior.

Args:
- $title: Modal title text
- $closable: Allow ESC/backdrop/X to close (default: true)
- $max_width: Maximum width in pixels (default: 800)

The modal body and footer are populated dynamically via the Modal.js API.

role="dialog" is what marks the content as a dialog - to assistive technology, and to
Rsx_Form, which binds a form inside a dialog to its instance rather than to the browser
history entry (reopening a dialog is a new act; rsx:man form_conventions, RESUBMITTING).
--%>
<Define:Rsx_Modal>
    <div class="modal fade rsx-modal" tabindex="-1" role="dialog" aria-modal="true" $sid="modal">
        <div class="modal-dialog" $sid="dialog">
            <div class="modal-content">
                <div class="modal-header" $sid="header">
                    <h5 class="modal-title" $sid="title"></h5>
                    <button type="button" class="btn-close" $sid="close_btn" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" $sid="body">
                    <div class="modal-body-content" $sid="body_content">
                        <!-- Dynamic content inserted here -->
                    </div>
                </div>
                <div class="modal-footer" $sid="footer">
                    <!-- Dynamic buttons inserted here -->
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade" $sid="backdrop"></div>
</Define:Rsx_Modal>
