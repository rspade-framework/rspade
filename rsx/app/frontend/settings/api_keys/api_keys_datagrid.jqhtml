<%-- API Keys DataGrid Component --%>

<Define:Api_Keys_DataGrid
    extends="DataGrid_Abstract"
    $data_source=Frontend_Settings_Api_Keys_Controller.datagrid_fetch
    $sort="status"
    $order="asc"
    $per_page=25
    class="card DataGrid">

    <Slot:DG_Card_Header>
        <Card_Title>Your API Keys</Card_Title>
        <Card_Header_Right>
            <Search_Input $sid="filter_input" $placeholder="Search by name..." />
        </Card_Header_Right>
    </Slot:DG_Card_Header>

    <Slot:DG_Table_Header>
        <tr>
            <th data-sortby="id" style="width: 80px;">ID</th>
            <th data-sortby="name">Name</th>
            <th>Key</th>
            <th>Access</th>
            <th>Scope</th>
            <th data-sortby="status">Status</th>
            <th data-sortby="created_at">Created</th>
            <th data-sortby="last_used_at">Last Used</th>
            <th style="width: 110px;">Actions</th>
        </tr>
    </Slot:DG_Table_Header>

    <Slot:row>
        <tr>
            <td>#<%= row.id %></td>
            <td><%= row.name %></td>
            <td>
                <code class="bg-light p-1 rounded"><%= row.key_prefix %></code>
            </td>
            <%-- Which VERBS this key may use. Beside Scope, which is which PATHS it may
                 reach - two independent narrowings, and a 403 comes from one or the other. --%>
            <td>
                <% if (row.read_only) { %>
                    <span class="badge bg-secondary">Read-only</span>
                <% } else { %>
                    <span class="text-muted">Read + write</span>
                <% } %>
            </td>
            <%-- Unrestricted, or how many scopes narrow the key. The scopes themselves are one
                 click away in the View modal - a table cell is not where a rule set is read. --%>
            <td>
                <% if (row.is_scoped) { %>
                    <span class="badge bg-secondary"><%= row.scope_summary %></span>
                <% } else { %>
                    <span class="text-muted"><%= row.scope_summary %></span>
                <% } %>
            </td>
            <td>
                <% if (row.status === 'active') { %>
                    <span class="badge bg-success">Active</span>
                <% } else if (row.status === 'revoked') { %>
                    <span class="badge bg-danger">Revoked</span>
                <% } else if (row.status === 'expired') { %>
                    <span class="badge bg-warning">Expired</span>
                <% } %>
            </td>
            <td><%= Rsx_Time.format_date(row.created_at) %></td>
            <td><%= row.last_used_at ? Rsx_Time.relative(row.last_used_at) : 'Never' %></td>
            <%-- An icon-only button group, so these use the outline style rather than the
                 filled one every other button in the app uses. --%>
            <td>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" data-action="view_scope" data-id="<%= row.id %>" title="View Scope">
                        <i class="bi bi-eye"></i>
                    </button>
                    <% if (row.status === 'active') { %>
                        <button class="btn btn-outline-danger" data-action="revoke" data-id="<%= row.id %>" title="Revoke Key">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    <% } %>
                </div>
            </td>
        </tr>
    </Slot:row>

    <Slot:DG_Empty_State>
        <div class="text-center py-5">
            <i class="bi bi-key fs-1 text-muted"></i>
            <p class="text-muted mt-3">No API keys yet. Generate your first key to get started.</p>
        </div>
    </Slot:DG_Empty_State>

</Define:Api_Keys_DataGrid>
