<Define:Settings_Api_Keys_Action>
<Page_Scaffold>
    <Slot:main>
        <% if (!this.data.has_api_access) { %>
            <Unauthorized_Error_Page_Component $message="API access is not enabled for your account" />
        <% } else { %>
            <p class="text-muted">
                API keys allow you to authenticate and interact with our API programmatically.
                Keep your keys secure and never share them publicly.
            </p>

            <Api_Keys_DataGrid $sid="api_keys_datagrid" />
        <% } %>
    </Slot:main>

    <Slot:sidebar>
        <%-- Two stacked actions of equal width, so they read as a pair rather than as a
             primary button with an afterthought beside it. Each label says what it is, so
             neither needs explanatory copy of its own. --%>
        <%-- Both actions lead somewhere the server refuses without API access, so the
             whole section goes rather than leaving buttons that only produce errors. --%>
        <% if (this.data.has_api_access) { %>
        <Section $title="Actions">
            <div class="Settings_Api_Keys_Action__actions">
                <button class="btn btn-primary btn-sm" $sid="btn_add_key">
                    <i class="bi bi-plus-circle"></i> Generate New Key
                </button>
                <a href="<%= Rsx.Route('Apidocs_Controller') %>" class="btn btn-secondary btn-sm">
                    <i class="bi bi-journal-code"></i> Online API Documentation
                </a>
            </div>
        </Section>
        <% } %>

        <Section $title="Security Best Practices">
            <ul class="list-unstyled mb-0 small">
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Store keys in environment variables</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Never commit keys to version control</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Rotate keys periodically</li>
                <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Use different keys for each environment</li>
                <li class="mb-0"><i class="bi bi-check-circle text-success me-2"></i>Revoke unused or compromised keys immediately</li>
            </ul>
        </Section>

        <Section $title="Rate Limits">
            <p class="small text-muted mb-2">Your current plan allows:</p>
            <ul class="small mb-0">
                <li>1,000 requests per hour</li>
                <li>10,000 requests per day</li>
            </ul>
        </Section>
    </Slot:sidebar>
</Page_Scaffold>
</Define:Settings_Api_Keys_Action>
