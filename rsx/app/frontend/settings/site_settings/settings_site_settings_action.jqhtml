<Define:Settings_Site_Settings_Action>
<Page_Scaffold>
    <Slot:main>
        <Rsx_Form $sid="site_form" $data=this.data.form_data $controller="Frontend_Settings_Site_Settings_Controller" $method="update">
            <Card_Widget>
                <Section $title="General Settings">
                    <Form_Errors />

                    <Form_Field $label="Site Name" $required=true>
                        <Text_Input $name="name" $max_length=this.data.name_max_length $placeholder="My Organization" />
                    </Form_Field>
                </Section>
                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </Card_Widget>
        </Rsx_Form>
    </Slot:main>

    <Slot:sidebar>
        <Section $title="Site Settings Tips">
            <ul class="list-unstyled mb-0">
                <li class="mb-0"><i class="bi bi-check-circle text-success me-2"></i>Keep your site name concise</li>
            </ul>
        </Section>
    </Slot:sidebar>
</Page_Scaffold>
</Define:Settings_Site_Settings_Action>
