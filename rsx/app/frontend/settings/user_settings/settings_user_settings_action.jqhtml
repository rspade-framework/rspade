<Define:Settings_User_Settings_Action>

    <Page_Scaffold>
        <Slot:main>
            <%-- The timezone preference round-trips through the framework's own
             Rsx_Timezone_Controller (no pass-through app controller). --%>
            <Section $title="Timezone">
                <%-- The REAL form renders immediately and unconditionally; the action
                     arms its loading overlay until the settings land. A placeholder
                     standing in for a form would show the user something that is not
                     the thing they are waiting for. --%>
                <Rsx_Form $sid="timezone_form"
                    $data=this.data.timezone_form_data
                    $controller="Rsx_Timezone_Controller"
                    $method="set_timezone">

                    <Form_Errors />

                    <div class="mb-3">
                        <Checkbox_Input $sid="timezone_auto_input" $name="timezone_auto"
                            $label="Automatically set timezone" />
                        <div class="form-text">
                            Keeps your timezone matched to the one your browser reports, once per
                            browser session. Choosing a timezone below turns this off.
                        </div>
                    </div>

                    <Form_Field $label="Timezone"
                        $help="Dates and times throughout the app are shown in this timezone.">
                        <Select_Input $sid="timezone_input" $name="timezone"
                            $options=this.data.timezone_options
                            $placeholder="Select Timezone..." />
                    </Form_Field>

                    <div class="d-flex">
                        <button type="submit" class="btn btn-primary">Save Timezone</button>
                    </div>
                </Rsx_Form>
            </Section>

            <Section $title="Appearance">
                <%-- Same shape as the timezone form above: the REAL form renders
                     immediately behind its own loading overlay, never a placeholder
                     standing in for it. --%>
                <Rsx_Form $sid="theme_form"
                    $data=this.data.theme_form_data
                    $controller="Rsx_Dark_Mode_Controller"
                    $method="set_dark_mode">

                    <Form_Errors />

                    <Form_Field $label="Theme"
                        $help="Auto matches your operating system's light or dark appearance.">
                        <Select_Input $sid="dark_mode_input" $name="dark_mode"
                            $options=this.data.theme_options />
                    </Form_Field>

                    <div class="d-flex">
                        <button type="submit" class="btn btn-primary">Save Theme</button>
                    </div>
                </Rsx_Form>
            </Section>

            <%-- Notification and privacy preferences: one form, one endpoint. Email
                 switches are the recipient opt-out for this user's address on this site;
                 the rest are preference variables on the user record. --%>
            <Section $title="Notifications and Privacy">
                <Rsx_Form $sid="preferences_form"
                    $data=this.data.preferences_form_data
                    $controller="Frontend_Settings_User_Settings_Controller"
                    $method="update">

                    <Form_Errors />

                    <h6 class="mb-2">Email Notifications</h6>
                    <% if (this.data.email_address) { %>
                        <p class="form-text mt-0 mb-3">Sent to <%= this.data.email_address %>.</p>
                        <div class="mb-2">
                            <Checkbox_Input $name="email_notification" $label="Notifications" />
                            <div class="form-text">Emails about activity on records you work with.</div>
                        </div>
                        <div class="mb-3">
                            <Checkbox_Input $name="email_marketing" $label="Product Updates and Promotions" />
                            <div class="form-text">News about new features, and promotional emails.</div>
                        </div>
                    <% } else if (this.data.email_address === undefined) { %>
                        <p class="form-text mt-0 mb-3">Loading...</p>
                    <% } else { %>
                        <p class="form-text mt-0 mb-3">
                            Your profile on this site has no email address, so no email is sent to you here.
                        </p>
                    <% } %>
                    <p class="form-text mb-4">
                        Account and security emails - invitations, password resets and sign-in codes - are always sent.
                    </p>

                    <h6 class="mb-2">In-App Notifications</h6>
                    <Checkbox_Input $name="inapp_task_assigned" $label="Task Assignments" />
                    <div class="form-text mb-4">When a task is assigned to you.</div>

                    <h6 class="mb-2">Privacy</h6>
                    <Form_Field $label="Profile Visibility">
                        <Select_With_Description_Input $name="profile_visibility"
                            $options=this.data.profile_visibility_options />
                    </Form_Field>

                    <div class="d-flex">
                        <button type="submit" class="btn btn-primary">Save Preferences</button>
                    </div>
                </Rsx_Form>
            </Section>
        </Slot:main>

        <Slot:sidebar>
            <Section $title="About Settings">
                <p class="small text-muted mb-2">
                    These settings control your timezone, your theme, how you are notified and who can see your profile.
                </p>
                <p class="small text-muted mb-0">
                    Each section is saved by its own button.
                </p>
            </Section>

            <Section $title="Need Help?">
                <p class="small text-muted mb-0">
                    Have questions about your settings? Reach out to your administrator for guidance.
                </p>
            </Section>
        </Slot:sidebar>
    </Page_Scaffold>

</Define:Settings_User_Settings_Action>