<Define:Settings_Password_Security_Action>
<Page_Scaffold>
    <Slot:main>
        <Section $title="Change Password">
            <form id="password-form">
                <div class="mb-3">
                    <label for="current_password" class="form-label">Current Password</label>
                    <input type="password" class="form-control" id="current_password" required>
                </div>
                <div class="mb-3">
                    <label for="new_password" class="form-label">New Password</label>
                    <input type="password" class="form-control" id="new_password" required>
                    <div class="form-text">Must be at least 8 characters with uppercase, lowercase, and numbers</div>
                </div>
                <div class="mb-3">
                    <label for="confirm_password" class="form-label">Confirm New Password</label>
                    <input type="password" class="form-control" id="confirm_password" required>
                </div>
                <button type="submit" class="btn btn-primary">Change Password</button>
            </form>
        </Section>

        <%-- TWO-FACTOR. Every row here is driven by ONE call to the framework's
             Rsx_Two_Factor_Controller.credentials_list(), because a screen that asked for the
             list, the code count and the enabled flag separately would paint three states
             that disagree with each other while they land. --%>
        <Section $title="Two-Factor Authentication">
            <% if (!this.data.two_factor) { %>
                <Loading_Spinner $message="Loading your security settings..." />
            <% } else {
                const _tf = this.data.two_factor;
                const _totp = _tf.credentials.filter(c => c.type_id === Settings_Password_Security_Action.TYPE_TOTP);
                const _passkeys = _tf.credentials.filter(c => c.type_id === Settings_Password_Security_Action.TYPE_PASSKEY);
            %>
                <div class="d-flex align-items-start justify-content-between gap-3 mb-4">
                    <div>
                        <h6 class="mb-1">Authenticator App</h6>
                        <p class="text-muted small mb-2">Use an authentication app to generate one-time security codes</p>
                        <% if (_totp.length > 0) { %>
                            <Status_Badge $label="Enabled" $badge="bg-success" />
                        <% } else { %>
                            <Status_Badge $label="Not Enabled" $badge="bg-secondary" />
                        <% } %>
                    </div>
                    <% if (_totp.length === 0) { %>
                        <button class="btn btn-sm btn-primary flex-shrink-0" data-action="enroll_totp">Enable</button>
                    <% } %>
                </div>

                <div class="d-flex align-items-start justify-content-between gap-3">
                    <div>
                        <h6 class="mb-1">Passkeys</h6>
                        <p class="text-muted small mb-2">Sign in with a security key, or with your device's fingerprint or face unlock</p>
                        <% if (_passkeys.length > 0) { %>
                            <Status_Badge $label="Enabled" $badge="bg-success" />
                        <% } else { %>
                            <Status_Badge $label="Not Enabled" $badge="bg-secondary" />
                        <% } %>
                        <%-- Passkeys need WebAuthn. An old browser, an insecure origin or a
                             locked-down device simply cannot do the ceremony, so say so
                             rather than offering a button that cannot work. --%>
                        <% if (!this.state.passkeys_supported) { %>
                            <p class="text-muted small mb-0 mt-2">This browser cannot use passkeys. Use an authenticator app instead.</p>
                        <% } %>
                    </div>
                    <% if (this.state.passkeys_supported) { %>
                        <button class="btn btn-sm btn-primary flex-shrink-0" data-action="register_passkey">
                            <%= _passkeys.length > 0 ? 'Add Passkey' : 'Enable' %>
                        </button>
                    <% } %>
                </div>

                <% if (_tf.credentials.length > 0) { %>
                    <div class="mt-4">
                        <h6 class="mb-2">Your Methods</h6>
                        <Record_Table>
                            <thead>
                                <tr><th>Name</th><th>Type</th><th>Added</th><th>Last Used</th><th></th></tr>
                            </thead>
                            <tbody>
                                <% for (const credential of _tf.credentials) { %>
                                <tr>
                                    <td><%= credential.label || credential.type_id__label %></td>
                                    <td><%= credential.type_id__label %></td>
                                    <td><%= Rsx_Time.format_datetime(credential.confirmed_at) %></td>
                                    <td>
                                        <% if (credential.last_used_at) { %>
                                            <%= Rsx_Time.format_datetime(credential.last_used_at) %>
                                        <% } else { %>
                                            <span class="text-muted">Never</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger no-row-nav"
                                                data-action="remove_credential" data-id="<%= credential.id %>">Remove</button>
                                    </td>
                                </tr>
                                <% } %>
                            </tbody>
                        </Record_Table>
                    </div>
                <% } %>

                <% if (_tf.is_enabled) { %>
                    <div class="d-flex align-items-start justify-content-between gap-3 mt-4">
                        <div>
                            <h6 class="mb-1">Recovery Codes</h6>
                            <p class="text-muted small mb-0">
                                <%= _tf.recovery_codes_remaining %> remaining. Each code signs you in
                                once if you lose your device.
                            </p>
                        </div>
                        <button class="btn btn-sm btn-outline-secondary flex-shrink-0" data-action="regenerate_codes">Regenerate</button>
                    </div>
                <% } %>
            <% } %>
        </Section>

        <Section $title="Active Sessions" $flush=true>
            <Slot:actions>
                <button class="btn btn-sm btn-danger">Revoke All Others</button>
            </Slot:actions>
            <Slot:body>
                <Record_Table>
                    <thead>
                        <tr><th>Device</th><th>Location</th><th>IP Address</th><th>Last Active</th><th></th></tr>
                    </thead>
                    <tbody>
                        <% for (const session of this.data.active_sessions) { %>
                        <tr>
                            <td>
                                <%= session.device %>
                                <% if (session.is_current) { %>
                                    <Status_Badge $label="Current" $badge="bg-success" />
                                <% } %>
                            </td>
                            <td><%= session.location %></td>
                            <td><%= session.ip %></td>
                            <td><%= session.last_active %></td>
                            <td>
                                <% if (!session.is_current) { %>
                                    <button class="btn btn-sm btn-outline-danger no-row-nav">Revoke</button>
                                <% } %>
                            </td>
                        </tr>
                        <% } %>
                    </tbody>
                </Record_Table>
            </Slot:body>
        </Section>
    </Slot:main>

    <Slot:sidebar>
        <Section $title="Security Tips">
            <ul class="list-unstyled mb-0">
                <li class="mb-2"><i class="bi bi-shield-check text-success me-2"></i>Use a unique password</li>
                <li class="mb-2"><i class="bi bi-shield-check text-success me-2"></i>Enable two-factor authentication</li>
                <li class="mb-2"><i class="bi bi-shield-check text-success me-2"></i>Review active sessions regularly</li>
                <li class="mb-0"><i class="bi bi-shield-check text-success me-2"></i>Keep recovery options up to date</li>
            </ul>
        </Section>

        <Section $title="Last Password Change">
            <p class="mb-0">Your password was last changed on <strong>October 15, 2024</strong></p>
        </Section>
    </Slot:sidebar>
</Page_Scaffold>
</Define:Settings_Password_Security_Action>
