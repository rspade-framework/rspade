<%-- Group Management DataGrid Component --%>

<Define:Groups_DataGrid
    extends="DataGrid_Abstract"
    $data_source=Frontend_Settings_Group_Management_Controller.datagrid_fetch
    $sort="id"
    $order="desc"
    $per_page=15
    class="card DataGrid">

    <Slot:DG_Card_Header>
        <Card_Title>Group List</Card_Title>
        <Card_Header_Right>
            <Search_Input $sid="filter_input" $placeholder="Search groups..." />
        </Card_Header_Right>
    </Slot:DG_Card_Header>

    <Slot:DG_Table_Header>
        <tr>
            <th class="checkbox-column">
                <input class="form-check-input" type="checkbox" $sid="select_all">
            </th>
            <th data-sortby="id">ID</th>
            <th data-sortby="name">Name</th>
            <th>Description</th>
            <th>Members</th>
            <th data-sortby="created_at">Created</th>
        </tr>
    </Slot:DG_Table_Header>

    <Slot:row>
        <tr data-href="<%= Rsx.Route('Settings_Group_Management_View_Action', row.id) %>">
            <td class="checkbox-column">
                <input class="form-check-input row-checkbox" type="checkbox" value="<%= row.id %>">
            </td>
            <td>
                #G<%= String(row.id).padStart(3, '0') %>
            </td>
            <td>
                <strong><%= row.name %></strong>
            </td>
            <td>
                <% if (row.description) { %>
                    <%= row.description.length > 50 ? row.description.substring(0, 50) + '...' : row.description %>
                <% } else { %>
                    <em class="text-muted">No description</em>
                <% } %>
            </td>
            <td>
                <span class="badge bg-secondary"><%= row.member_count %> members</span>
            </td>
            <td><%= Rsx_Time.format_date(row.created_at) %></td>
        </tr>
    </Slot:row>


    <%-- Footer mass actions. Export only: a group is removed from its own screen, where the
         rules for doing so live. The item mirrors the endpoint's 'can_export_data' gate. --%>
    <Slot:footer_actions>
        <% if (Permission.has_permission(User_Model.PERM_DATA_EXPORT)) { %>
            <li>
                <a class="dropdown-item" href="#" data-action="export">
                    <i class="bi bi-download"></i> Export to CSV
                </a>
            </li>
        <% } %>
    </Slot:footer_actions>

</Define:Groups_DataGrid>
