<%--
Edit_User_Modal_Form - Modal form for editing user information

this.args.user_id - the user being edited

An EDIT modal: the record arrives AFTER the dialog opens, so this component is the
loader and its JS class carries the procedure (fetch in on_create, overlay armed in
on_render, values applied through the form's populate() in on_ready).

The template renders the real form unconditionally - the overlay is what the user
waits behind, never a placeholder standing in for the form.
--%>
<Define:Edit_User_Modal_Form>

  <%-- Roles come from the User_Model enum (selectable ones only), narrowed to the
       roles the signed-in user may administer - the same rule the endpoint enforces. --%>
  <% const _role_options = User_Model.role_id__enum_select()
       .filter(o => Permission.can_admin_role(int(o.value))); %>

  <Rsx_Form $controller="Frontend_Settings_User_Management_Controller" $method="save_user">

    <Form_Errors />

    <Hidden_Input $name="id" />

    <Form_Field $label="Email Address" $required=true>
      <Text_Input $name="email" $type="email" $placeholder="user@example.com" $max_length=User_Model.field_length('email') $autofocus=true />
    </Form_Field>

    <div class="row">
      <div class="col-tablet-6">
        <Form_Field $label="First Name" $required=true>
          <Text_Input $name="first_name" $max_length=User_Model.field_length('first_name') />
        </Form_Field>
      </div>
      <div class="col-tablet-6">
        <Form_Field $label="Last Name" $required=true>
          <Text_Input $name="last_name" $max_length=User_Model.field_length('last_name') />
        </Form_Field>
      </div>
    </div>

    <Form_Field $label="Role" $required=true>
      <Select_Input $name="role_id" $options=_role_options />
    </Form_Field>

    <Form_Field $label="Phone Number">
      <Phone_Text_Input $name="phone" $placeholder="(555) 123-4567" />
    </Form_Field>

    <Form_Field $label="API Access"
      $help="When off, this user's API keys stop working and no new ones can be used.">
      <Checkbox_Input $name="is_api_access_enabled" $label="Allow API access" />
    </Form_Field>

    <Form_Field $label="Two-Factor Authentication"
      $help="When on, this user must set up two-factor authentication before they can use the app.">
      <Checkbox_Input $name="is_2fa_required" $label="Require two-factor authentication" />
    </Form_Field>

  </Rsx_Form>

</Define:Edit_User_Modal_Form>
