<%--
Edit_User_Modal_Form - Modal form for editing user information

this.args.user_id - the user being edited

An EDIT modal: the record loads in on_load() (see the JS class) and is the form's $data.
Edit_User_Modal opens it with spinner_until_ready: 'always', so the dialog shows its
spinner until this component is ready and the form appears with its values in place.
--%>
<Define:Edit_User_Modal_Form>

  <%-- Roles come from the User_Model enum, narrowed to the roles the signed-in user may
       administer - the same rule the endpoint enforces. Every role is listed (not only the
       selectable ones) so a user already holding a system-assigned role, such as Root
       Admin, keeps it on save; the endpoint refuses ASSIGNING a non-selectable role to
       anyone who does not already hold it. --%>
  <% const _role_options = Object.entries(User_Model.role_id__enum_labels())
       .map(([value, label]) => ({value: int(value), label: label}))
       .filter(o => Permission.can_admin_role(o.value)); %>

  <Rsx_Form $sid="form" $controller="Frontend_Settings_User_Management_Controller" $method="save_user" $data=this.data.record>

    <Form_Errors />

    <Hidden_Input $name="id" />

    <Form_Field $label="Email Address" $required=true>
      <Text_Input $name="email" $type="email" $placeholder="user@example.com" $max_length=User_Model.field_length('email') $autofocus=true />
    </Form_Field>

    <div class="row">
      <div class="col-tablet-6">
        <Form_Field $label="First Name" $required=true>
          <Text_Input $name="first_name" $max_length=User_Model.field_length('first_name') />
        </Form_Field>
      </div>
      <div class="col-tablet-6">
        <Form_Field $label="Last Name" $required=true>
          <Text_Input $name="last_name" $max_length=User_Model.field_length('last_name') />
        </Form_Field>
      </div>
    </div>

    <div class="row">
      <div class="col-tablet-6">
        <Form_Field $label="Role" $required=true>
          <Select_Input $name="role_id" $options=_role_options />
        </Form_Field>
      </div>
      <div class="col-tablet-6">
        <Form_Field $label="Phone Number">
          <Phone_Text_Input $name="phone" $placeholder="(555) 123-4567" />
        </Form_Field>
      </div>
    </div>

    <Form_Field $label="API Access"
      $help="When off, this user's API keys stop working and no new ones can be used.">
      <Checkbox_Input $name="is_api_access_enabled" $label="Allow API access" />
    </Form_Field>

  </Rsx_Form>

</Define:Edit_User_Modal_Form>
