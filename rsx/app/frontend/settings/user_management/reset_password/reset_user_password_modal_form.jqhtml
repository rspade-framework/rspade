<%--
Reset_User_Password_Modal_Form - the body of Reset_User_Password_Modal

this.args.user_id - the user whose password is set

The record (name, sign-in address) loads in on_load(); the dialog shows its spinner until it
is ready. The password field is shown in clear: the administrator reads it out to the user.
--%>
<Define:Reset_User_Password_Modal_Form>

  <Rsx_Form $sid="form" $controller="Frontend_Settings_User_Management_Controller" $method="set_user_password" $data=this.data.record>

    <Form_Errors />

    <Hidden_Input $name="id" />

    <%-- WHOSE password this is, for a password manager to file it under the TARGET user and never
         over the administrator's own saved login (CREDENTIAL FIELDS, rsx/app/login/CLAUDE.md).
         No name: the endpoint reads the user from id, never from this field. --%>
    <input type="email" $sid="username" $autofill_id="email" autocomplete="username"
           value="<%= (this.data.record && this.data.record.sign_in_email) || '' %>" readonly hidden />

    <p>
      Set a temporary password for <strong><%= (this.data.record && this.data.record.name) || '' %></strong>.
      They will be asked to choose a new password the next time they sign in, and are signed out everywhere now.
      No email is sent: read the password out to them.
    </p>

    <Form_Field $label="Temporary Password" $required=true>
      <Text_Input $name="new_password" $type="text" $max_length=-1 $autofocus=true
        $autofill_id="new_password" $autocomplete="new-password" />
    </Form_Field>

  </Rsx_Form>

</Define:Reset_User_Password_Modal_Form>
