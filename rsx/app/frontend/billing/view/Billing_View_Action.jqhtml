<Define:Billing_View_Action>
<% if (this.data.loading) { %>
    <Page_Scaffold>
        <Slot:main>
            <Loading_Spinner $message="Loading entry..." />
        </Slot:main>
    </Page_Scaffold>
<% } else if (this.data.error_data) { %>
    <Page_Scaffold>
        <Slot:main>
            <Universal_Error_Page_Component
                $error_data="<%= this.data.error_data %>"
                $record_type="Entry"
                $back_label="Go back to Billing"
                $back_url="<%= Rsx.Route('Billing_Index_Action') %>"
            />
        </Slot:main>
    </Page_Scaffold>
<% } else { %>
    <%
        const _e = this.data.entry;
        const _d = this.data.detail;
        const _invoice = this.data.invoice;
        const _activity = this.data.activity;
        const _can_view_activity = Activity_Feed.can_view();
        const _can_change = this.can_change();
        const _can_decide = this.can_decide();
        const _is_time = _e.type_id === Billable_Entry_Model.TYPE_TIME;
        const _is_expense = _e.type_id === Billable_Entry_Model.TYPE_EXPENSE;
        const _rejected = _e.status === Billable_Entry_Model.STATUS_REJECTED;
        const _tabs = [
            { key: 'overview', label: 'Overview' },
            ...(_can_view_activity ? [{ key: 'activity', label: 'Activity', count: _activity.length }] : []),
        ];
    %>
    <Page_Scaffold>
        <Slot:main>
            <Card_Widget>
                <Entity_Header>
                    <Slot:title><%= _e.description %></Slot:title>
                    <Slot:chips>
                        <Status_Badge $label=_e.status__label $badge=_e.status__badge />
                        <Billing_Kind_Chip $label=_e.type_id__label $badge=_e.type_id__badge />
                    </Slot:chips>
                    <Slot:meta>
                        <span><%= Rsx_Date.format(_e.entry_date) %></span>
                        <span>Project: <Entity_Link $model="Project_Model" $id=_e.project_id $small=true /></span>
                        <span>Logged <%= Rsx_Time.format_date(_e.created_at) %></span>
                        <% if (_invoice) { %><span>On invoice <%= _invoice.invoice_number_formatted %></span><% } %>
                    </Slot:meta>
                </Entity_Header>

                <Tab_Bar $sid="tabs" $tabs=_tabs $hash="tab" $divided=true />

                <Tab_Panels $sid="panels">
                    <Tab_Panel $key="overview">
                        <% if (_rejected && _e.rejection_reason) { %>
                            <Callout $variant="danger" $icon="bi bi-x-octagon">
                                <Slot:title>Rejected</Slot:title>
                                <Slot:body><%= _e.rejection_reason %></Slot:body>
                            </Callout>
                        <% } %>

                        <Section $title="Entry">
                            <View_Fields>
                                <View_Field $label="Date"><%= Rsx_Date.format(_e.entry_date) %></View_Field>
                                <View_Field $label="Person"><Entity_Link $model="User_Model" $id=_e.user_id /></View_Field>
                                <View_Field $label="Project"><Entity_Link $model="Project_Model" $id=_e.project_id /></View_Field>
                                <View_Field $label="Task">
                                    <% if (_e.task_id) { %><Entity_Link $model="Task_Model" $id=_e.task_id /><% } else { %><Empty_Value /><% } %>
                                </View_Field>
                                <View_Field $label="Description"><%= _e.description %></View_Field>
                                <View_Field $label="Amount">
                                    <% if (_e.amount !== null) { %><strong><%= _e.amount %></strong><% } else { %><Empty_Value /><% } %>
                                </View_Field>
                                <% if (_e.invoice_id) { %>
                                <View_Field $label="Invoice">
                                    <% if (!_invoice) { %>
                                        Invoiced
                                    <% } else if (Permission.can_access('Invoices_View_Action')) { %>
                                        <a href="<%= Rsx.Route('Invoices_View_Action', _invoice.id) %>"><%= _invoice.invoice_number_formatted %></a>
                                        <Status_Badge $label=_invoice.status__label $badge=_invoice.status__badge />
                                    <% } else { %>
                                        <%= _invoice.invoice_number_formatted %>
                                    <% } %>
                                </View_Field>
                                <% } %>
                            </View_Fields>
                        </Section>

                        <%-- The kind's own fields, from its detail row (the detail-tables accessor). --%>
                        <% if (_is_time) { %>
                            <Section $title="Time">
                                <View_Fields>
                                    <View_Field $label="Hours"><% if (_d) { %><%= _d.hours %><% } else { %><Empty_Value /><% } %></View_Field>
                                    <View_Field $label="Hourly Rate"><% if (_d && _d.hourly_rate !== null) { %><%= _d.hourly_rate %><% } else { %><Empty_Value /><% } %></View_Field>
                                </View_Fields>
                            </Section>
                        <% } else if (_is_expense) { %>
                            <Section $title="Expense">
                                <View_Fields>
                                    <View_Field $label="Vendor"><% if (_d && _d.vendor) { %><%= _d.vendor %><% } else { %><Empty_Value /><% } %></View_Field>
                                    <View_Field $label="Cost"><% if (_d && _d.cost !== null) { %><%= _d.cost %><% } else { %><Empty_Value /><% } %></View_Field>
                                    <View_Field $label="Receipt">
                                        <Billing_Receipt $sid="receipt" $entry_id=_e.id $can_change=_can_change />
                                    </View_Field>
                                </View_Fields>
                            </Section>
                        <% } else { %>
                            <Section $title="Fixed Fee">
                                <Empty_State $icon="bi bi-cash-coin">
                                    <Slot:title>No further details</Slot:title>
                                    <Slot:body>A fixed fee is its amount alone &mdash; it has no detail record.</Slot:body>
                                </Empty_State>
                            </Section>
                        <% } %>

                        <% if (_e.reviewed_by_user_id) { %>
                            <Section $title="Review">
                                <View_Fields>
                                    <View_Field $label="Reviewed By"><Entity_Link $model="User_Model" $id=_e.reviewed_by_user_id /></View_Field>
                                    <View_Field $label="Reviewed"><%= Rsx_Time.format_timestamp(_e.reviewed_at) %></View_Field>
                                </View_Fields>
                            </Section>
                        <% } %>
                    </Tab_Panel>

                    <% if (_can_view_activity) { %>
                    <Tab_Panel $key="activity">
                        <Section $title="Activity" $count=_activity.length $flush=true>
                            <% if (_activity.length === 0) { %>
                                <Empty_State $icon="bi bi-activity">
                                    <Slot:title>No activity yet</Slot:title>
                                    <Slot:body>Changes to this entry will appear here.</Slot:body>
                                </Empty_State>
                            <% } else { %>
                                <% for (const a of _activity) { %>
                                    <Feed_Row $icon=a.icon $variant=a.variant>
                                        <Slot:body><%!= a.html %></Slot:body>
                                        <Slot:time><%= Rsx_Time.relative(a.created_at) %></Slot:time>
                                    </Feed_Row>
                                <% } %>
                            <% } %>
                        </Section>
                    </Tab_Panel>
                    <% } %>
                </Tab_Panels>
            </Card_Widget>
        </Slot:main>

        <Slot:sidebar>
            <Detail_Sidebar>
                <Sidebar_Kpi_Group>
                    <Kpi_Cell $tooltip="What this entry bills">
                        <Slot:label>Amount</Slot:label>
                        <Slot:value><% if (_e.amount !== null) { %><%= _e.amount %><% } else { %>&mdash;<% } %></Slot:value>
                    </Kpi_Cell>
                    <% if (_can_view_activity) { %>
                    <Kpi_Cell $clickable=true $tab="activity" $tooltip="Recorded activity for this entry">
                        <Slot:label>Activity</Slot:label>
                        <Slot:value><%= _activity.length %></Slot:value>
                    </Kpi_Cell>
                    <% } %>
                </Sidebar_Kpi_Group>

                <View_Fields>
                    <View_Field $label="Entry ID" $inline=true>#<%= _e.id %></View_Field>
                    <View_Field $label="Kind" $inline=true><%= _e.type_id__label %></View_Field>
                    <View_Field $label="Status" $inline=true><%= _e.status__label %></View_Field>
                    <View_Field $label="Updated" $inline=true><%= Rsx_Time.format_date(_e.updated_at) %></View_Field>
                </View_Fields>

                <div class="d-grid gap-2">
                    <% if (_can_decide) { %>
                        <button type="button" class="btn btn-success btn-sm" data-action="approve">
                            <i class="bi bi-check-lg"></i> Approve
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm" data-action="reject">
                            <i class="bi bi-x-lg"></i> Reject
                        </button>
                    <% } %>
                    <% if (_can_change) { %>
                        <button type="button" class="btn btn-primary btn-sm" data-action="submit">
                            <i class="bi bi-send"></i> Submit for Approval
                        </button>
                        <a href="<%= Rsx.Route('Billing_Edit_Action', _e.id) %>" class="btn btn-outline-primary btn-sm">
                            <i class="bi bi-pencil"></i> Edit Entry
                        </a>
                    <% } %>
                    <% if (Permission.can_access('Billing_History_Action')) { %>
                        <a href="<%= Rsx.Route('Billing_History_Action', _e.id) %>" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-clock-history"></i> History
                        </a>
                    <% } %>
                </div>
                <% if (_can_change) { %>
                <div class="d-flex justify-content-end">
                    <Action_Menu $label="More entry actions">
                        <button type="button" class="dropdown-item text-danger" data-action="delete">
                            <i class="bi bi-trash"></i> Delete Entry
                        </button>
                    </Action_Menu>
                </div>
                <% } %>
            </Detail_Sidebar>
        </Slot:sidebar>
    </Page_Scaffold>
<% } %>
</Define:Billing_View_Action>
