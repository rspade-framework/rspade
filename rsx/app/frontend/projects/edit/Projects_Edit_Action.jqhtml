<Define:Projects_Edit_Action>
<% if (this.data.error_data) { %>
    <Page_Scaffold>
        <Slot:main>
            <Universal_Error_Page_Component
                $error_data="<%= this.data.error_data %>"
                $record_type="Project"
                $back_label="Go back to Projects"
                $back_url="<%= Rsx.Route('Projects_Index_Action') %>"
            />
        </Slot:main>
    </Page_Scaffold>
<% } else { %>
    <Page_Scaffold>
        <Slot:main>
            <Rsx_Form $data=this.data.form_data $controller="Frontend_Projects_Controller" $method="save">
                <% if (this.data.is_edit) { %>
                    <Hidden_Input $name="id" />
                <% } %>

                <Card_Widget>
                    <Section $title="Project Information">
                        <Form_Errors />

                        <Form_Field $label="Project Name" $required=true>
                            <Text_Input $name="name" $placeholder="Enter project name" $max_length=Project_Model.field_length('name') />
                        </Form_Field>

                        <%--
                        The DYNAMIC COMPONENT TAG, and the one situation it is for: the
                        editor is whatever `description`'s declared text type says edits it,
                        so this form names no widget. Change Project_Model::$text_types and
                        the editor here changes with it - which is the promise the whole
                        text-type feature makes, and it cannot be kept by a template that
                        hardcodes <Wysiwyg_Input>.

                        Note it asks the MODEL, not the value. There is no value to ask at
                        this moment: on /projects/add every field is null, and on an edit the
                        record is still being fetched. The column's type is known
                        synchronously; the value is not.

                        This is an advanced form and almost nothing else should use it - see
                        `rsx:man jqhtml`, DYNAMIC COMPONENT TAGS. An ordinary conditional
                        around two literal tags is the right answer everywhere else.
                        --%>
                        <Form_Field $label="Description">
                            <{Project_Model.editor_component_for('description')} $name="description"
                                $placeholder="Enter project description..." />
                        </Form_Field>

                        <div class="row">
                            <div class="col-tablet-6">
                                <% if (this.data.is_edit || this.data.from_client) { %>
                                    <%-- Client is locked (editing or adding from client view) --%>
                                    <Hidden_Input $name="client_id" />
                                    <div class="mb-3">
                                        <label class="form-label">Client</label>
                                        <div><Entity_Link $model="Client_Model" $id="<%= this.data.form_data.client_id %>" /></div>
                                    </div>
                                <% } else { %>
                                    <%-- Adding new project - show dropdown selector --%>
                                    <Form_Field $label="Client" $required=true>
                                        <Client_Selector_Input $name="client_id" />
                                    </Form_Field>
                                <% } %>
                            </div>
                            <div class="col-tablet-6">
                                <%-- Parent project (self-referencing hierarchy). Remote-search picker;
                                     in edit mode the project's own id + subtree are excluded (cycle guard). --%>
                                <Form_Field $label="Parent Project">
                                    <% if (this.data.is_edit) { %>
                                        <Ajax_Entity_Select_Input $name="parent_project_id" $parent_type="Project_Model" $exclude_id="<%= this.data.form_data.id %>" $placeholder="Search projects..." />
                                    <% } else { %>
                                        <Ajax_Entity_Select_Input $name="parent_project_id" $parent_type="Project_Model" $placeholder="Search projects..." />
                                    <% } %>
                                </Form_Field>
                            </div>
                        </div>
                    </Section>

                    <Section $title="Team & Contacts">
                        <Form_Field $label="Assigned Users">
                            <Checkbox_Multiselect_Input $name="assigned_users" $options="<%= this.data.user_options %>" $empty_text="No users available" />
                        </Form_Field>

                        <% if (this.data.show_contacts) { %>
                            <Form_Field $label="Contacts">
                                <Checkbox_Multiselect_Input $name="contacts" $options="<%= this.data.contact_options %>" $empty_text="No contacts for this client" />
                            </Form_Field>
                        <% } %>
                    </Section>

                    <Section $title="Timeline & Budget">
                        <div class="row">
                            <div class="col-tablet-6">
                                <Form_Field $label="Start Date">
                                    <Text_Input $name="start_date" $type="date" $max_length=-1 />
                                </Form_Field>
                            </div>
                            <div class="col-tablet-6">
                                <Form_Field $label="Due Date">
                                    <Text_Input $name="due_date" $type="date" $max_length=-1 />
                                </Form_Field>
                            </div>
                        </div>
                        <Form_Field $label="Budget">
                            <Text_Input $name="budget" $type="number" $placeholder="0.00" $max_length=-1 />
                        </Form_Field>
                    </Section>

                    <Section $title="Notes">
                        <%-- Also derived from the column's declared type. --%>
                        <Form_Field $label="Internal Notes">
                            <{Project_Model.editor_component_for('notes')} $name="notes" $rows=4
                                $placeholder="Internal notes about this project..." />
                        </Form_Field>
                    </Section>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="<%= Rsx.Route('Projects_Index_Action') %>" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Save Project
                        </button>
                    </div>
                </Card_Widget>
            </Rsx_Form>
        </Slot:main>
    </Page_Scaffold>
<% } %>
</Define:Projects_Edit_Action>
