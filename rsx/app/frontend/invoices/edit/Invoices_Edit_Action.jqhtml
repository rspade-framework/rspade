<Define:Invoices_Edit_Action>
<% if (this.data.error_data) { %>
    <Page_Scaffold>
        <Slot:main>
            <Universal_Error_Page_Component
                $error_data="<%= this.data.error_data %>"
                $record_type="Invoice"
                $back_label="Go back to Invoices"
                $back_url="<%= Rsx.Route('Invoices_Index_Action') %>"
            />
        </Slot:main>
    </Page_Scaffold>
<% } else { %>
    <% const _cancel = Rsx.Route('Invoices_View_Action', this.args.id); %>
    <Page_Scaffold>
        <Slot:main>
            <% if (!this.is_open()) { %>
                <Callout $variant="warning" $icon="bi bi-lock">
                    <Slot:title>This invoice is <%= this.data.invoice.status__label %></Slot:title>
                    <Slot:body>A paid or void invoice can no longer be edited. <a href="<%= _cancel %>">Back to the invoice</a></Slot:body>
                </Callout>
            <% } else { %>
            <Rsx_Form $data=this.data.form_data $controller="Frontend_Invoices_Controller" $method="save">
                <Hidden_Input $name="id" />

                <Card_Widget>
                    <Section $title="<%= this.data.invoice.invoice_number_formatted %>">
                        <Form_Errors />

                        <div class="row">
                            <div class="col-tablet-6">
                                <Form_Field $label="Issue Date">
                                    <Text_Input $name="issue_date" $type="date" $max_length=-1 />
                                </Form_Field>
                            </div>
                            <div class="col-tablet-6">
                                <Form_Field $label="Due Date" $help="Not before the issue date.">
                                    <Text_Input $name="due_date" $type="date" $max_length=-1 />
                                </Form_Field>
                            </div>
                        </div>

                        <Form_Field $label="Notes">
                            <{Invoice_Model.editor_component_for('notes')} $name="notes" $rows=4
                                $placeholder="Payment instructions, a purchase order number..." />
                        </Form_Field>
                    </Section>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="<%= _cancel %>" class="btn btn-secondary" @click=this.discard_changes>
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Save Invoice
                        </button>
                    </div>
                </Card_Widget>
            </Rsx_Form>
            <% } %>
        </Slot:main>
    </Page_Scaffold>
<% } %>
</Define:Invoices_Edit_Action>
