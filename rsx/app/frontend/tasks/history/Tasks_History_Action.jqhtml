<Define:Tasks_History_Action>
<% if (this.data.loading) { %>
    <Page_Scaffold>
        <Slot:main>
            <Loading_Spinner $message="Loading history..." />
        </Slot:main>
    </Page_Scaffold>
<% } else if (this.data.error_data) { %>
    <Page_Scaffold>
        <Slot:main>
            <Universal_Error_Page_Component
                $error_data="<%= this.data.error_data %>"
                $record_type="Task"
                $back_label="Go back to Tasks"
                $back_url="<%= Rsx.Route('Tasks_Index_Action') %>"
            />
        </Slot:main>
    </Page_Scaffold>
<% } else { %>
    <% const _record = this.data.record; %>
    <Page_Scaffold>
        <Slot:main>
            <Card_Widget>
                <Entity_Header>
                    <Slot:title><%= _record.title %></Slot:title>
                    <Slot:meta>
                        <span>Task #<%= _record.id %></span>
                        <span><a href="<%= Rsx.Route('Tasks_View_Action', _record.id) %>">Back to the task</a></span>
                    </Slot:meta>
                </Entity_Header>

                <Section $title="Change History" $icon="bi bi-clock-history">
                    <%-- The component owns the whole timeline: loading, paging and the
                         per-field before/after formatting. --%>
                    <Revision_History $record_type="Task_Model" $record_id=_record.id />
                </Section>
            </Card_Widget>
        </Slot:main>
    </Page_Scaffold>
<% } %>
</Define:Tasks_History_Action>
