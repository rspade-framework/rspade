<Define:Contacts_History_Action>
<% if (this.data.loading) { %>
    <Page_Scaffold>
        <Slot:main>
            <Loading_Spinner $message="Loading history..." />
        </Slot:main>
    </Page_Scaffold>
<% } else if (this.data.error_data) { %>
    <Page_Scaffold>
        <Slot:main>
            <Universal_Error_Page_Component
                $error_data="<%= this.data.error_data %>"
                $record_type="Contact"
                $back_label="Go back to Contacts"
                $back_url="<%= Rsx.Route('Contacts_Index_Action') %>"
            />
        </Slot:main>
    </Page_Scaffold>
<% } else { %>
    <% const _record = this.data.record; %>
    <Page_Scaffold>
        <Slot:main>
            <Card_Widget>
                <Entity_Header>
                    <Slot:title><%= _record.full_name %></Slot:title>
                    <Slot:meta>
                        <span>Contact <%= _record.contact_id_formatted %></span>
                        <span><a href="<%= Rsx.Route('Contacts_View_Action', _record.id) %>">Back to the contact</a></span>
                    </Slot:meta>
                </Entity_Header>

                <Section $title="Change History" $icon="bi bi-clock-history">
                    <%-- The component owns the whole timeline: loading, paging and the
                         per-field before/after formatting. --%>
                    <Revision_History $record_type="Contact_Model" $record_id=_record.id />
                </Section>
            </Card_Widget>
        </Slot:main>
    </Page_Scaffold>
<% } %>
</Define:Contacts_History_Action>
