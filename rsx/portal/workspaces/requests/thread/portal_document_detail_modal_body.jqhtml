<%--
Portal_Document_Detail_Modal_Body - static body for the client document detail dialog.
Renders a centered thumbnail + metadata (name, review-state badge, reject reason if any)
from the $document row passed by Portal_Document_Detail_Modal. Download lives on the
modal's buttons; there are no review actions on the portal.
--%>
<Define:Portal_Document_Detail_Modal_Body tag="div">
  <% const doc = this.args.document; %>
  <a class="Portal_Document_Detail_Modal_Body__thumb-wrap" href="<%= doc.download_url %>" download title="Download <%= doc.name %>">
    <Attachment_Thumbnail class="Portal_Document_Detail_Modal_Body__thumb" $attachment_id=doc.attachment_id $width=220 $height=220 $alt=doc.name />
  </a>

  <div class="Portal_Document_Detail_Modal_Body__name"><%= doc.name %></div>

  <div class="Portal_Document_Detail_Modal_Body__meta">
    <span class="badge <%= doc.badge %>"><%= doc.review_label %></span>
  </div>

  <% if (doc.reject_reason) { %>
    <div class="alert alert-danger Portal_Document_Detail_Modal_Body__reason mt-3 mb-0">
      <span class="fw-semibold d-block">Rejection reason</span>
      <%br= doc.reject_reason %>
    </div>
  <% } %>
</Define:Portal_Document_Detail_Modal_Body>
