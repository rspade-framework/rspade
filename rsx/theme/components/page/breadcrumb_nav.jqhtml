<%--
Breadcrumb_Nav

Renders a breadcrumb chain from an array of crumb objects.
Uses Bootstrap 5 breadcrumb styling.

$crumbs - Array of { label: string|null, url: string|null, href: string|null, is_active: boolean,
          resolved: boolean } objects - Rsx_Breadcrumb_Resolver's chain items. The link is
          `href`: the crumb's page in the state the user left it in when they came through it
          (Spa.return_url()); `url` is the page's identity. The last item is the current page
          and is never a link. When label is null, shows "------" placeholder (still loading).

Usage (from layout JS):
    $breadcrumbs.component('Breadcrumb_Nav', { crumbs: [
        { label: 'Dashboard', url: '/dashboard', href: '/dashboard', is_active: false, resolved: true },
        { label: 'Contacts', url: '/contacts', href: '/contacts#contacts_datagrid_page=3&_scroll=840', is_active: false, resolved: true },
        { label: null, url: '/contacts/view/7', href: '/contacts/view/7', is_active: true, resolved: false }
    ] });
--%>
<Define:Breadcrumb_Nav tag="nav" aria-label="breadcrumb">
    <ol class="breadcrumb mb-0">
        <% for (let i = 0; i < this.args.crumbs.length; i++) {
            const crumb = this.args.crumbs[i];
            const is_last = i === this.args.crumbs.length - 1;
        %>
            <% if (is_last || !crumb.href) { %>
                <li class="breadcrumb-item active" aria-current="page"><% if (crumb.label === null) { %><span class="Breadcrumb_Nav__placeholder">------</span><% } else { %><%= crumb.label %><% } %></li>
            <% } else { %>
                <li class="breadcrumb-item"><a href="<%= crumb.href %>"><% if (crumb.label === null) { %><span class="Breadcrumb_Nav__placeholder">------</span><% } else { %><%= crumb.label %><% } %></a></li>
            <% } %>
        <% } %>
    </ol>
</Define:Breadcrumb_Nav>
