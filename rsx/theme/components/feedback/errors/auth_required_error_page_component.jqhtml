<%--
Auth_Required_Error_Page_Component

Displays when a user must be logged in to access a resource but is not authenticated.
This is shown when accessing protected routes or endpoints without valid authentication.

$message - Custom error message (optional, auto-generated if not provided)
$redirect_url - URL to return to after login (optional)
--%>
<Define:Auth_Required_Error_Page_Component class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-person-lock-fill text-info" style="font-size: 4rem;"></i>
    </div>
    <h3 class="mb-3">Login Required</h3>
    <p class="text-muted mb-4">
        <%= this.args.message || 'Please log in to continue' %>.
    </p>
    <a href="<%= Rsx.Route('Login_Controller') %>" class="btn btn-primary">
        Log In
    </a>
</Define:Auth_Required_Error_Page_Component>
