<%--
Server_Error_Page_Component

Displays when a server error occurs (HTTP 500+). This indicates an internal server error,
such as a PHP exception, database error, or other unexpected server-side failure.
The error has been logged automatically.

$message - Custom error message (optional, auto-generated if not provided)
--%>
<Define:Server_Error_Page_Component class="text-center py-5">
    <div class="mb-4">
        <i class="bi bi-server text-danger" style="font-size: 4rem;"></i>
    </div>
    <h3 class="mb-3">Server Error</h3>
    <p class="text-muted mb-4">
        <%= this.args.message || 'A server error occurred. Please try again.' %>
    </p>
    <p class="text-muted small mb-4">
        This error has been automatically logged. If the problem persists, please contact support.
    </p>
    <% this.handle_retry = () => window.location.reload(); %>
    <button class="btn btn-primary" @click=this.handle_retry>
        Try Again
    </button>
</Define:Server_Error_Page_Component>
