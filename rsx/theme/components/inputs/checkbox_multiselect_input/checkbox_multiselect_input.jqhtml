<%--
Checkbox_Multiselect_Input - Multi-select checkbox list widget

A form widget that displays a list of checkboxes and returns an array of selected values.
Designed for selecting multiple items from a predefined list (e.g., group members, tags).

$options - Array of {id, label, disabled?, subtitle?} objects to display as checkboxes
$columns - Number of columns (default: 2)
$empty_text - Text to show when no options available (default: "No options available")

Widget interface:
- val() - Get array of checked IDs
- val([1, 2, 3]) - Set checked state from array of IDs

Example:
<Checkbox_Multiselect_Input $options="<%= JSON.stringify(this.args.users) %>" />
--%>
<Define:Checkbox_Multiselect_Input extends="Form_Input_Abstract">
    <% const options = this.args.options || []; %>
    <% const columns = this.args.columns || 2; %>
    <% const col_class = 'col-' + (12 / columns); %>

    <% if (options.length === 0) { %>
        <div class="text-muted small py-2">
            <%= this.args.empty_text || 'No options available' %>
        </div>
    <% } else { %>
        <div class="row g-2" $sid="checkbox_list">
            <% for (let option of options) { %>
                <div class="<%= col_class %>">
                    <label class="d-flex align-items-center border rounded px-2 py-1 <%= option.disabled ? 'text-muted' : '' %>" style="cursor: pointer;">
                        <input type="checkbox"
                               class="form-check-input me-2 mt-0 multiselect-checkbox"
                               value="<%= option.id %>"
                               <% if (option.disabled) { %>disabled<% } %>>
                        <span class="text-truncate" title="<%= option.label %>">
                            <%= option.label %>
                            <% if (option.subtitle) { %><small class="text-muted">(<%= option.subtitle %>)</small><% } %>
                        </span>
                    </label>
                </div>
            <% } %>
        </div>
    <% } %>
</Define:Checkbox_Multiselect_Input>
