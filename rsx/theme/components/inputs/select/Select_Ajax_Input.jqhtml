<%--
Select_Ajax_Input

Dropdown select widget that loads options via Ajax.
Extends Select_Input with Ajax data loading capability.

$source - Ajax endpoint returning the option array (a controller stub method,
          e.g. $source=My_Controller.options); each option is a {value, label}
          object or a plain value. Subclasses with a fixed endpoint
          (Select_Country_Input, Select_State_Input) override on_load() instead.
$placeholder - Placeholder option text (default: "Please wait...")
$disabled - Boolean to disable the select

Widget interface:
- val() - Get/set selected value (handles pre-initialization calls)

Features:
- Loads options asynchronously from $source during on_load(); a failed call is
  not swallowed
- Shows "Please wait..." while loading
- Handles val() calls before initialization completes
- Re-renders with actual options once loaded
--%>
<Define:Select_Ajax_Input extends="Select_Input">
    <select $sid="input" <% if (this.args.disabled) { %>disabled<% } %>>
        <% if (!this.data.select_values || this.data.select_values.length === 0) { %>
            <option value=""><%= this.args.placeholder || 'Please wait...' %></option>
        <% } else { %>
            <% if (this.args.placeholder) { %>
                <option value=""><%= this.args.placeholder %></option>
            <% } %>
            <% for (let opt of this.data.select_values) { %>
                <% if (typeof opt === 'object') { %>
                    <option value="<%= opt.value %>" <% if (this.data.value == opt.value) { %>selected<% } %>><%= opt.label %></option>
                <% } else { %>
                    <option value="<%= opt %>" <% if (this.data.value == opt) { %>selected<% } %>><%= opt %></option>
                <% } %>
            <% } %>
        <% } %>
    </select>
</Define:Select_Ajax_Input>
