<%--
Pin_Verification_Form

6-digit PIN entry form with automatic navigation between boxes.

Features:
- Auto-advance to next box when digit is entered
- Backspace clears current box and moves to previous
- Paste support: distributes digits across boxes
- Validates numeric input only

Usage in modal:
const result = await Modal.form({
    title: "Enter PIN",
    component: "Pin_Verification_Form",
    on_submit: async (form) => {
        const pin = form.val();
        if (pin.length !== 6) {
            return false; // Keep modal open
        }
        // Verify PIN...
        return { success: true, pin: pin };
    }
});
--%>
<Define:Pin_Verification_Form extends="Rsx_Form">
    <div class="Pin_Verification_Form__inputs d-flex justify-content-center gap-2 mb-3">
        <input $sid="digit_0" type="text" class="form-control Pin_Verification_Form__input text-center" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" data-index="0" />
        <input $sid="digit_1" type="text" class="form-control Pin_Verification_Form__input text-center" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" data-index="1" />
        <input $sid="digit_2" type="text" class="form-control Pin_Verification_Form__input text-center" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" data-index="2" />
        <input $sid="digit_3" type="text" class="form-control Pin_Verification_Form__input text-center" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" data-index="3" />
        <input $sid="digit_4" type="text" class="form-control Pin_Verification_Form__input text-center" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" data-index="4" />
        <input $sid="digit_5" type="text" class="form-control Pin_Verification_Form__input text-center" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="off" data-index="5" />
    </div>

    <div $sid="error_container" data-id="error_container" class="alert alert-danger" style="display: none;"></div>

    <div class="Pin_Verification_Form__hint text-center text-muted small">
        Enter the 6-digit PIN code
    </div>
</Define:Pin_Verification_Form>
