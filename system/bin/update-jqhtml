#!/bin/bash
# Update all jqhtml packages to latest versions
cd "$(dirname "$0")"
cd ..

echo "Updating jqhtml packages to latest versions..."

# Update the @jqhtml packages. These come from PUBLIC npm - there is no
# registry configuration and no credential; @jqhtml/router,
# @jqhtml/vscode-extension and @jqhtml/webpack-loader were dropped in the move
# (nothing imported them, and the last of those names belongs to somebody else
# on the public registry).
npm update @jqhtml/core @jqhtml/parser @jqhtml/ssr
rm -rf storage/rsx_*

# Show installed versions
echo ""
echo "Current jqhtml package versions:"
npm list 2>/dev/null | grep "@jqhtml/" | grep -v deduped
