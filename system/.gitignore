# Storage directory (except cdn-cache which is committed)
/storage/*
!/storage/rsx-build/
/storage/rsx-build/*
!/storage/rsx-build/cdn-cache/

# Hand-made snapshots of storage/ taken while debugging the clean/build scenarios.
# Three of these (7,410 files of pure build output - php_reflection JSON, compiled
# scss, formatter caches) were committed years ago and then shipped in every release
# inventory, where they made up 98% of the non-owned entries: they camouflaged real
# damage 490-to-1 and could fail a completeness check that had no power to repair
# them (field report, 2026-08-11). The glob is deliberately narrow - it names the shape
# that actually leaked rather than guessing at future ones.
/storage_cli_clean_*/

# Supervisor files
supervisord.log*
supervisord.pid*
*.log
*.pid

