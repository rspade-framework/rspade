{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "*": [
        "*",
        "storage/rsx/js-stubs/*"
      ]
    },
    "target": "es6",
    "module": "commonjs",
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "rsx/**/*.js",
    "storage/rsx/js-stubs/**/*.js",
    "app/RSpade/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "public"
  ]
}