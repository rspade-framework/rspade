{
  "name": "@jqhtml/core",
  "version": "2.3.54",
  "description": "Core runtime library for JQHTML",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./debug": {
      "import": "./dist/jqhtml-debug.esm.js",
      "types": "./dist/debug.d.ts"
    },
    "./bundle": {
      "import": "./dist/jqhtml-core.esm.js"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "build:tsc": "tsc",
    "watch": "rollup -c -w",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "clean": "rm -rf dist"
  },
  "jest": {
    "setupFiles": [
      "<rootDir>/test/jest.setup.js"
    ]
  },
  "peerDependencies": {
    "jquery": "^3.7.0"
  },
  "browser": true,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "laravel-bridge",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "jquery",
    "components",
    "framework",
    "jqhtml",
    "templating"
  ],
  "author": "JQHTML Team",
  "license": "MIT",
  "dependencies": {
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/jest": "^29.5.14",
    "@types/jquery": "^3.5.32",
    "esbuild": "^0.25.9",
    "jest": "^29.5.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.53.2",
    "rollup": "^4.49.0",
    "rollup-plugin-dts": "^6.2.3",
    "ts-jest": "^29.1.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": null,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jqhtml/jqhtml.git"
  },
  "bugs": {
    "url": "https://github.com/jqhtml/jqhtml/issues"
  },
  "homepage": "https://github.com/jqhtml/jqhtml#readme"
}
