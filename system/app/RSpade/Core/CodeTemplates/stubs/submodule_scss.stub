.{{ submodule_css_class }} {
    // Sidebar styles
    .sidebar {
        min-height: calc(100vh - 56px);
        padding: 0;

        .sidebar-heading {
            font-size: 0.75rem;
            text-transform: uppercase;
        }

        .nav-link {
            color: #333;
            padding: 0.5rem 1rem;

            &.active {
                color: #0d6efd;
                background-color: rgba(13, 110, 253, 0.1);
                border-left: 3px solid #0d6efd;
            }

            &:hover:not(.active) {
                background-color: #f8f9fa;
            }

            i {
                width: 20px;
                text-align: center;
                margin-right: 0.5rem;
            }
        }
    }

    // Main content area
    main {
        padding-bottom: 2rem;
    }

    // Card adjustments
    .card {
        border: 0;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    // Responsive adjustments
    @media (max-width: 767px) {
        .sidebar {
            position: static;
            min-height: auto;
            padding: 1rem 0;
        }
    }
}