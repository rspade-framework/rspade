<%--
Document_Preview

Renders a real, in-browser preview of a file attachment by resolving a viewer component from the
server (File_Preview_Controller::get_preview_info) and dispatching to it. The framework ships three
viewers (Pdf_Viewer, Image_Viewer, Icon_Viewer); an app may register additional viewers in
config('rsx.preview.viewers'), which are instantiated dynamically in on_ready.

Args:
  $attachment_id  (required) - the File_Attachment_Model id to preview. Throws if absent.
  $page           (optional) - initial page for paginated viewers (default 1).
  $width/$height  (optional) - fixed dimensions in px; omitted -> fills the container (100%).

Events OUT (re-emitted from the active viewer):
  'preview_loaded' {pages, width, height, ratio}  (NOT 'loaded' - that is a reserved jqhtml
                                                   lifecycle event fired internally with no data)
  'page_changed'   {page}

Public methods (delegate to the active viewer; no-op before it is ready):
  set_page(n) / get_page() / get_pages()
--%>
<Define:Document_Preview tag="div">
    <% if (!this.args.attachment_id) { throw new Error('Document_Preview requires $attachment_id'); } %>
    <%
        const _w = this.args.width ? (int(this.args.width) + 'px') : '100%';
        const _h = this.args.height ? (int(this.args.height) + 'px') : '100%';
        const _frame_style = 'width:' + _w + ';height:' + _h + ';';
    %>
    <div class="Document_Preview__frame" style="<%= _frame_style %>">
        <% if (this.data.info && this.data.info.preview_unavailable) { %>
            <%-- Degraded upload (image bytes were unparseable): no viewer is instantiated, so
                 on_ready finds no $sid="viewer" component and no-ops. --%>
            <div class="Document_Preview__unavailable">
                <img class="Document_Preview__unavailable-icon" src="<%= this.data.info.urls.icon %>" alt="">
                <div class="Document_Preview__unavailable-title">Preview unavailable</div>
                <% if (this.data.info.file_name) { %>
                    <div class="Document_Preview__unavailable-name"><%= this.data.info.file_name %></div>
                <% } %>
            </div>
        <% } else if (this.data.info) { %>
            <% const _v = this.data.info.viewer; %>
            <% if (_v === 'Pdf_Viewer') { %>
                <Pdf_Viewer $sid="viewer" $url=this.data.info.urls.rendition $page=(this.args.page||1) />
            <% } else if (_v === 'Image_Viewer') { %>
                <Image_Viewer $sid="viewer" $url=this.data.info.urls.inline />
            <% } else if (_v === 'Icon_Viewer') { %>
                <Icon_Viewer $sid="viewer" $url=this.data.info.urls.icon $extension=this.data.info.extension $file_name=this.data.info.file_name />
            <% } else { %>
                <div $sid="viewer" class="Document_Preview__dynamic"></div>
            <% } %>
        <% } %>
    </div>
</Define:Document_Preview>
