<Define:Api_Docs_Page tag="div">
<% const d = this.data; %>
<% if (d.loading) { %>
    <div class="Api_Docs_Page__notice">Loading API catalog...</div>
<% } else if (d.error) { %>
    <div class="Api_Docs_Page__notice Api_Docs_Page__notice--error"><%= d.error %></div>
<% } else if (!d.catalog || !d.catalog.versions || d.catalog.versions.length === 0) { %>
    <div class="Api_Docs_Page__notice">No external API endpoints are defined.</div>
<% } else { %>
    <% const cat = d.catalog; %>

    <header class="Api_Docs_Page__header">
        <div class="Api_Docs_Page__brand">
            <span class="Api_Docs_Page__brand-mark">{&nbsp;}</span>
            <span class="Api_Docs_Page__brand-text">REST API Reference</span>
        </div>
        <div class="Api_Docs_Page__header-controls">
            <label class="Api_Docs_Page__version">
                <span class="Api_Docs_Page__version-caption">Version</span>
                <select $sid="version_select" class="Api_Docs_Page__version-select">
                    <% for (const v of cat.versions) { %>
                        <option value="<%= v %>" <% if (v === cat.selected_version) { %>selected<% } %>>v<%= v %></option>
                    <% } %>
                </select>
            </label>
            <a class="Api_Docs_Page__catalog-link" href="<%= Rsx.Route('Api_Docs_Controller::llm_catalog') %>" target="_blank" rel="noopener">
                <%!= api_icon('external') %>
                <span>Machine-readable catalog (JSON for LLMs / integration agents)</span>
            </a>
        </div>
    </header>

    <div class="Api_Docs_Page__keybar-host">
        <Api_Key_Bar />
    </div>

    <div class="Api_Docs_Page__body">
        <nav class="Api_Docs_Page__sidebar" $sid="sidebar">
            <% for (const [rk, group] of Object.entries(cat.resolved)) { %>
                <div class="Api_Docs_Page__nav-group">
                    <div class="Api_Docs_Page__nav-title"><%= group.name %></div>
                    <% for (const ep of group.endpoints) { %>
                        <a class="Api_Docs_Page__nav-link" href="#<%= ep._anchor %>" data-anchor="<%= ep._anchor %>">
                            <span class="Api_Docs_Page__nav-verbs">
                                <% for (const m of ep.methods) { %>
                                    <% const mc = 'Api_Docs_Page__pill--' + m.toLowerCase(); %>
                                    <span class="Api_Docs_Page__pill <%= mc %>"><%= m %></span>
                                <% } %>
                            </span>
                            <span class="Api_Docs_Page__nav-path"><%= ep.path_key %></span>
                        </a>
                    <% } %>
                </div>
            <% } %>
        </nav>

        <main class="Api_Docs_Page__main" $sid="main">
            <% for (const [rk, group] of Object.entries(cat.resolved)) { %>
                <section class="Api_Docs_Page__resource">
                    <h2 class="Api_Docs_Page__resource-title"><%= group.name %></h2>
                    <% for (const ep of group.endpoints) { %>
                        <Api_Endpoint_Card $endpoint=ep $anchor=ep._anchor />
                    <% } %>
                </section>
            <% } %>
        </main>
    </div>
<% } %>
</Define:Api_Docs_Page>
