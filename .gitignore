# RSX IDE Helper (auto-generated by manifest)
_rsx_helper.php

# App dependency layer (tracked): project-root composer.json/package.json plus
# their lock files are the application's own dependencies, managed via
# rsx:composer / rsx:npm and layered on top of the framework's committed deps.
# Their installs (root /vendor and /node_modules) are committed too, per the
# framework's commit-everything philosophy - so they are intentionally NOT
# ignored here. This template keeps zero app-layer deps, so those trees are
# absent in this repo; they appear only once a downstream app installs a package.

# The three volatile trees, all at the project root, none of them tracked.
#
#   storage/  per-environment user data and process state - the file-attachment blob
#             store, thumbnail and rendition caches, logs, storage/state.
#   build/    build outputs - the manifest index, compiled bundles, the Laravel caches,
#             compiled Blade, the seal. Regenerated by the build, never committed.
#   tmp/      derived caches and runtime temp. Deletable at any moment.
#
# The mirrored external assets - the one tracked build INPUT - live in
# rsx/resource/.cdn-cache/ (see App\RSpade\Core\Bundle\Cdn_Cache), deliberately
# outside all three.
/storage/*
/build/*
/tmp/*

# Test database snapshot (developer-specific, created locally)
/system/app/RSpade/tests/_lib/test_db_snapshot.sql

# Test environment backup (contains production credentials)
/system/.env.testbackup

# Cross-filesystem atomic-write staging dirs (file_put_contents_safe / rsx:clean)
.tmp_*/
