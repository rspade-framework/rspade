# RSpade environment. Copy to .env and fill in the values for this box. 

APP_NAME="RSpade"

# Minted on the first development boot; must be set by hand on a production box.
APP_KEY=
# The one hostname source. https on any host with TLS: APP_URL=https://$HOSTNAME
APP_URL=

# Application mode: development, debug or production. Written by rsx:mode:set,
# never by hand. php artisan rsx:man prod
RSX_MODE=development

# The initial user (login_users id 1) is created from these on the first migrate
# when both are set; leave empty to use the first-run setup screen instead.
RSPADE_DEFAULT_EMAIL=
RSPADE_DEFAULT_PASSWORD=

# Pre-fill the login form with the default credentials. Development only; never
# on a box anyone else can reach.
RSPADE_LOGIN_AUTOFILL=

# Log verbosity. debug on a development box; info on a production box (rsx:health
# warns when a production box logs at debug).
LOG_LEVEL=debug
LOGROTATE_ENABLED=true
LOGROTATE_DAYS_UNCOMPRESSED=3
LOGROTATE_DAYS_RETENTION=21

# MySQL Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rspade
DB_USERNAME=rspade
DB_PASSWORD=rspadepass
# The separate database rsx:test runs against; the runner refuses when it equals DB_DATABASE.
DB_TEST_DATABASE=rspade_test

# Redis Credentials
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# aiosmtpd (local catcher) | live | suppressed | disabled. MAILER..PASSWORD: live only.
MAIL_DELIVERY=aiosmtpd
MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# console_debug() output: the CLI stream, the browser console, Ajax responses.
# Stripped from a production build regardless. php artisan rsx:man console_debug
CONSOLE_DEBUG_ENABLED=true
CONSOLE_DEBUG_CLI=true
CONSOLE_DEBUG_WEB=true
CONSOLE_DEBUG_AJAX=true
# Comma-separated channel names to show, empty for all.
CONSOLE_DEBUG_FILTER=
CONSOLE_DEBUG_BENCHMARK=true

# Forward browser-side JS errors into the server log.
LOG_BROWSER_ERRORS=false

# Temporary files: derived caches, generated stubs, sockets and scratch. Wholly disposable; rsx:clean empties it.
RSX_TMP_PATH=./tmp

# Persistent data: uploads, logs, and storage/state. Must be writable by the web user and must survive every deployment.
RSX_STORAGE_PATH=./storage

# --- Services. The defaults match the shipped container; change them only when a
# --- service runs elsewhere.

# Realtime relay (WebSocket push). php artisan rsx:man realtime
REALTIME_ENABLED=true
REALTIME_WS_PORT=6200

# Cluster lock daemon. php artisan rsx:man locks
LOCK_SERVER_HOST=127.0.0.1
LOCK_SERVER_PORT=6210

