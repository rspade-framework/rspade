APP_NAME="RSpade"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=

# RSX Application Mode: development, debug, or production
RSX_MODE=development

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rspade
DB_USERNAME=rspade
DB_PASSWORD=rspadepass

BROADCAST_DRIVER=log

CACHE_DRIVER=redis
CACHE_STORE=redis
REDIS_CACHE_DB=1

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=525600

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

# Realtime WebSocket system (see php artisan rsx:man realtime)
REALTIME_ENABLED=true
REALTIME_WS_PORT=6200

# rsx-lockd, the web-cluster lock daemon (see php artisan rsx:man locks).
# Keep in sync with the daemon's own lockd.conf - the Node daemon reads that
# JSON file, not this .env.
LOCK_SERVER_HOST=127.0.0.1
LOCK_SERVER_PORT=6210

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# console_debug() output routing: the CLI stream and the browser console.
SHOW_CONSOLE_DEBUG_CLI=true
SHOW_CONSOLE_DEBUG_HTTP=true
CONSOLE_DEBUG_FILTER_MODE=all
CONSOLE_DEBUG_BENCHMARK=true

# Full-page cache for server-rendered pages. 0 = no expiry (invalidated on change).
SSR_FPC_ENABLED=true
FPC_TTL_MINS=0

# Forward browser-side JS errors into the server log.
LOG_BROWSER_ERRORS=false
